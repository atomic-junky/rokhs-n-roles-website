---
import AdherentPage from '../../../layouts/AdherentPage.astro'
import ReservationDateCard from '../../../components/ReservationDateCard.astro'
import { loadBooking, dateParameter, weekdayOf } from '../../../lib/reservations'

const requestedWeek = Astro.url.searchParams.get('week')
const parsedDate = requestedWeek
	? new Date(`${requestedWeek}T12:00:00`)
	: new Date()
const selectedDate = Number.isNaN(parsedDate.getTime())
	? new Date()
	: parsedDate
const monday = new Date(selectedDate)
const dayOfWeek = monday.getDay() || 7
monday.setDate(monday.getDate() - dayOfWeek + 1)
const previousWeek = new Date(monday)
previousWeek.setDate(monday.getDate() - 7)
const nextWeek = new Date(monday)
nextWeek.setDate(monday.getDate() + 7)
const calendarDays = Array.from({ length: 7 }, (_, index) => {
	const date = new Date(monday)
	date.setDate(monday.getDate() + index)
	return {
		date,
		weekday: weekdayOf(date),
		weekdayLabel: new Intl.DateTimeFormat('fr-FR', { weekday: 'long' }).format(
			date
		),
		shortLabel: new Intl.DateTimeFormat('fr-FR', { weekday: 'short' }).format(
			date
		),
		label: new Intl.DateTimeFormat('fr-FR', {
			day: 'numeric',
			month: 'short'
		}).format(date)
	}
})

const weekLabel = `${calendarDays[0].label} - ${calendarDays[6].label}`

let { rooms, getDay } = await loadBooking({
	from: dateParameter(calendarDays[0].date),
	to: dateParameter(calendarDays[6].date)
})

rooms = rooms.filter((room) =>
	calendarDays.some((day) => getDay(room, day.date).status !== 'empty')
)

const availableCount = (date: Date) =>
	rooms.filter((room) => getDay(room, date).status === 'available').length
const compactCardForDate = (date: Date) =>
	rooms.some((room) => getDay(room, date).status !== 'empty')
---

<AdherentPage
	title="Réservations"
	description="Consultez les salles disponibles cette semaine et sélectionnez un créneau."
>
	<section>
		<div class="reservation-page">
			<header class="reservation-header">
				<p class="eyebrow">Espace réservation</p>
				<h1>Liste des salles</h1>
				<p>
					Liste des crénaux disponibles par semaines et par salles.
				</p>
			</header>
			<main class="rooms-list">
				<nav class="week-navigation" aria-label="Navigation entre les semaines">
					<a href={`?week=${dateParameter(previousWeek)}`}>&larr;</a
					><strong>{weekLabel}</strong><a
						href={`?week=${dateParameter(nextWeek)}`}>&rarr;</a>
				</nav>
				{
					rooms.map((room) => (
						<article class="room-section">
							<div class="room-info">
								<>
									<p class="eyebrow">{room.location}</p>
									<h3>{room.name}</h3>
								</>
							</div>
							<div class="room-calendar">
								{calendarDays.map((day) => {
									const info = getDay(room, day.date)
									return (
										<ReservationDateCard
                                            href={
													(info.status === 'empty' || info.status === 'closed' || info.status === 'past')
													? undefined
													: `./${room.slug}/${info.key}`
											}
											dayLabel={day.weekdayLabel}
											dateLabel={day.label}
                                            status={info.status}
											description={info.description}
											time={info.closed ? 'Vacances scolaires' : info.time}
											compact={!compactCardForDate(day.date)}
										/>
									)
								})}
							</div>
						</article>
					))
				}
			</main>
		</div>
	</section>
</AdherentPage>

<style>
	.reservation-page {
		display: grid;
		gap: 2rem;
	}
	.reservation-header {
		display: grid;
		gap: 0.5rem;
	}
	.reservation-header h1,
	.reservation-header p {
		margin: 0;
	}
	.rooms-list {
		display: grid;
		gap: 1rem;
	}
	.rooms-heading,
	.week-navigation {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}
	.week-navigation {
		justify-content: center;
	}
	.week-navigation a {
		color: var(--primary);
		font-size: 1.8rem;
	}
	.rooms-heading h2 {
		margin: 0;
	}
	.rooms-heading span {
		font-size: var(--small);
		opacity: 0.65;
	}
	.week-overview {
		display: grid;
		grid-template-columns: repeat(7, minmax(70px, 1fr));
		gap: 0.4rem;
	}
	.week-day {
		display: grid;
		gap: 0.2rem;
		padding: 0.6rem;
		border: 1px solid color-mix(in srgb, var(--text) 15%, transparent);
		border-radius: var(--border05);
		font-size: var(--small);
	}
	.week-day.weekend {
		border-color: var(--secondary);
		background: color-mix(in srgb, var(--secondary) 12%, var(--background));
	}
	.room-section {
		display: grid;
		grid-template-columns: 170px minmax(0, 1fr);
		gap: 1rem;
		padding: 1rem;
		border: 1px solid color-mix(in srgb, var(--text) 15%, transparent);
		border-radius: var(--border05);
		background: color-mix(in srgb, var(--background) 88%, var(--secondary));
	}
	.room-info {
		display: grid;
		align-content: center;
		gap: 0.35rem;
	}
	.room-info h3,
	.room-info p {
		margin: 0;
	}
	.room-info a {
		width: fit-content;
		color: var(--text);
		border-bottom-color: var(--text);
		font-size: var(--small);
	}
	.room-calendar {
		display: flex;
		flex-flow: row nowrap;
		gap: 0.5rem;
		overflow-x: auto;
	}
	@media screen and (max-width: 760px) {
		.week-overview {
			overflow-x: auto;
			grid-template-columns: repeat(7, minmax(90px, 1fr));
			padding-bottom: 0.4rem;
		}
		.room-section {
			grid-template-columns: 1fr;
		}
		.room-calendar {
			grid-template-columns: repeat(7, minmax(100px, 1fr));
		}
	}
</style>
