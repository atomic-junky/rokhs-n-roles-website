---
import ReservationDateCard from '../../../../components/ReservationDateCard.astro'
import AdherentPage from '../../../../layouts/AdherentPage.astro'
import {
	loadBooking,
	dateParameter,
	formatSlot
} from '../../../../lib/reservations'
import { title } from '../../../../utils/helpers'

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=3600')

const slug = Astro.params.room ?? ''
const dateValue = Astro.params.date ?? ''
const parsedDate = /^\d{4}-\d{2}-\d{2}$/.test(dateValue)
	? new Date(`${dateValue}T12:00:00`)
	: null
if (!parsedDate || Number.isNaN(parsedDate.getTime()))
	return new Response(null, { status: 404 })

const lastDate = new Date(parsedDate)
lastDate.setDate(parsedDate.getDate() + 45)

const { rooms, getDay } = await loadBooking({
	roomSlug: slug,
	from: dateValue,
	to: dateParameter(lastDate)
})

const room = rooms.find((r) => r.slug === slug)
if (!room) return new Response(null, { status: 404 })

const dateLabel: string = new Intl.DateTimeFormat('fr-FR', {
	weekday: 'long',
	day: 'numeric',
	month: 'long',
	year: 'numeric'
}).format(parsedDate)
const day = getDay(room, parsedDate)
const isOpen = day.status === 'available' || day.status === 'reserved';
const isManager = day.reservation?.manager === room.manager;
const statusClass = isOpen ? day.status : day.status === 'past' ? 'past' : 'closed';
const statusLabel = { available: 'Disponible', reserved: 'Réservée', closed: 'Indisponible', past: 'Date passée', empty: '' }[statusClass];
const otherDates = Array.from({ length: 45 }, (_, index) => {
	const date = new Date(parsedDate)
	date.setDate(parsedDate.getDate() + index + 1)
	return getDay(room, date)
})
	.filter((other) => other.status !== 'empty' && other.status !== 'closed' && other.status !== 'past')
	.slice(0, 3)
---

<AdherentPage
	title={`${room.name} - ${dateLabel}`}
	description={`Informations sur ${room.name} le ${dateLabel}.`}
>
	<section>
		<div class="reservation-detail">
			<a class="back-link" href={`../`}
				>&larr; Retour aux réservations</a
			>

			<header class="detail-banner">
				<div class="detail-heading">
					<p class="eyebrow">{room.location} · {room.name}</p>
					<h1>{title(dateLabel)}</h1>
					<div class="detail-meta">
						{day.time && <span>{day.time}</span>}
						<span class:list={['status', statusClass]}>{statusLabel}</span>
					</div>
				</div>
				<div
					class="room-image-placeholder"
					role="img"
					aria-label={`Image de ${room.name}`}
				>
				</div>
			</header>

			<main class="detail-body">
				{
					isOpen ? (
						day.slots.map(({ availability, reservation }) =>
							reservation ? (
								<section class="reservation-info">
									{day.slots.length > 1 && (
										<p class="eyebrow">{formatSlot(availability)}</p>
									)}
									<p class="reservation-description">
										{reservation.description}
									</p>
									<div class="information-grid">
										<div>
											<>
												<span>Responsable</span>
												<strong>{reservation.manager} {isManager && (<small>(vous)</small>)}</strong>
												{isManager && (
													<button class="primary-button" type="button">
														Annuler la réservation
													</button>
												)}
											</>
										</div>
										<div>
											<>
												<span>Joueurs</span>
												<strong>
													{reservation.members.length
														? reservation.members.join(', ')
														: 'Pas de joueurs'}
												</strong>
												{!isManager && (
													<button class="primary-button" type="button">
														Rejoindre
													</button>
												)}
											</>
										</div>
									</div>
								</section>
							) : (
								<section class="reservation-info free-info">
									{day.slots.length > 1 && (
										<p class="eyebrow">{formatSlot(availability)}</p>
									)}
									<div class="information-grid">
										<div>
											<span>Responsable</span>
											<strong>Pas de responsable</strong>
											<button
												class="primary-button reserve-inline"
												type="button"
												data-open-reservation
												data-availability={availability.id}
												data-slot={formatSlot(availability)}
											>
												Réserver
											</button>
										</div>
										<div>
											<>
												<span>Joueurs</span>
												<strong>Pas de joueurs</strong>
											</>
										</div>
									</div>
								</section>
							)
						)
					) : (
						<section class="reservation-info">
							<strong>
								{day.status === 'past'
									? 'Cette date est passée.'
									: day.closed
										? 'La salle est fermée pendant les vacances scolaires.'
										: 'Pas de créneau à cette date.'}
							</strong>
						</section>
					)
				}

				<section class="other-dates">
					<div class="other-dates-list">
						{
							otherDates.map((other) => (
								<ReservationDateCard
									href={`../${room.slug}/${other.key}`}
									dayLabel={new Intl.DateTimeFormat('fr-FR', {
										weekday: 'short',
										day: 'numeric',
										month: 'short'
									}).format(other.date)}
									dateLabel={new Intl.DateTimeFormat('fr-FR', {
										day: 'numeric',
										month: 'short'
									}).format(other.date)}
									status={other.status}
									description={other.description}
									time={other.closed ? 'Vacances scolaires' : other.time}
								/>
							))
						}
					</div>
				</section>
			</main>
		</div>
	</section>
</AdherentPage>

<dialog data-reservation-dialog>
	<form method="dialog" class="dialog-content">
		<div class="dialog-header">
			<p class="eyebrow">Réservation - {room.name}</p>
			<button class="icon-button" value="cancel" aria-label="Fermer"
				>&times;</button
			>
		</div>
		<div class="reservation-dialog-detail">
			<h2>{dateLabel}</h2>
			<p data-dialog-slot></p>
		</div>
		<input type="hidden" name="availability" />
		<input type="hidden" name="date" value={day.key} />
		<div class="dialog-section">
			<label for="type">Type de partie</label>
			<select name="type" required>
				{
					[
						{ value: 'jdr', label: 'Jeux de rôle' },
						{ value: 'jds', label: 'Jeux de société' },
						{ value: 'autre', label: 'Autre' },
					].map((option) => (
						<option value={option.value}>{option.label}</option>
					))
				}
			</select>
		</div>
		<textarea
			name="description"
			rows="5"
			placeholder="Description (facultatif)"></textarea>
		<input type="submit" data-book-slot class="primary-button" value="Réserver la salle"/>
	</form>
</dialog>

<script>
	import { actions, isInputError, type ActionError } from 'astro:actions'

	const bookSlot = actions.bookSlot as (input: {
		availability: number
		date: string
		type: 'jdr' | 'jds' | 'autre'
		description?: string
	}) => Promise<void>

	document.addEventListener('astro:page-load', () => {
		const dialog = document.querySelector<HTMLDialogElement>(
			'[data-reservation-dialog]'
		)
		if (!dialog) return
		const slotLabel = dialog.querySelector<HTMLElement>('[data-dialog-slot]')
		const availabilityInput = dialog.querySelector<HTMLInputElement>(
			'input[name="availability"]'
		)

		document
			.querySelectorAll<HTMLButtonElement>('[data-open-reservation]')
			.forEach((trigger) => {
				if (trigger.dataset.ready) return
				trigger.dataset.ready = 'true'
				trigger.addEventListener('click', () => {
					if (slotLabel) slotLabel.textContent = trigger.dataset.slot ?? ''
					if (availabilityInput)
						availabilityInput.value = trigger.dataset.availability ?? ''
					dialog.showModal()
				})
			})
	})

	document.addEventListener('click', (event) => {
		const target = event.target as Element

		if (target.closest('[data-book-slot]')) {
			bookSlot({
				availability: Number(
					(document.querySelector<HTMLInputElement>(
						'input[name="availability"]'
					)?.value ?? 0)
				),
				date: document.querySelector<HTMLInputElement>(
					'input[name="date"]'
				)?.value ?? '',
				type: document.querySelector<HTMLSelectElement>(
					'select[name="type"]'
				)?.value as 'jdr' | 'jds' | 'autre',
				description: document.querySelector<HTMLTextAreaElement>(
					'textarea[name="description"]'
				)?.value
			})
		}
	})
</script>

<style>
	.reservation-detail {
		display: flex;
		min-height: 70vh;
		flex-direction: column;
		gap: 1.5rem;
	}
	.back-link {
		width: fit-content;
		color: var(--text);
		border-bottom-color: var(--text);
		font-size: var(--small);
	}
	.detail-banner {
		position: relative;
		display: grid;
		min-height: 320px;
		overflow: hidden;
		border-radius: var(--border05);
	}
	.room-image-placeholder {
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--secondary) 12%, var(--background));
	}
	.detail-banner::after {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgb(21 20 25 / 12%),
			rgb(21 20 25 / 72%)
		);
		content: '';
	}
	.detail-heading {
		z-index: 1;
		align-self: end;
		padding: 2rem;
		color: #fff;
	}
	.detail-heading h1 {
		margin: 0 0 1rem;
	}
	.detail-heading .eyebrow {
		color: #fff;
	}
	.detail-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		font-size: var(--small);
	}
	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}
	.status::before {
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 50%;
		content: '';
	}
	.status.available::before {
		background: #4c9a6b;
	}
	.status.reserved::before {
		background: #d59a3a;
	}
	.status.closed::before {
		background: #999;
	}
	.detail-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 1.5rem;
	}
	.reservation-info {
		display: grid;
		gap: 0.75rem;
	}
	.information-grid {
		display: flex;
		flex-flow: row wrap;
		gap: 1.5rem;
	}
	.information-grid div {
		display: flex;
		flex-flow: column wrap;
		flex: 1;
		gap: 0.3rem;
	}
	.information-grid span {
		font-size: var(--small);
		opacity: 0.7;
	}
	.reserve-inline {
		width: fit-content;
		margin-top: 0.35rem;
	}
	.action-section {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.action-context {
		display: grid;
		gap: 0.2rem;
	}
	.action-context span {
		font-size: var(--small);
		opacity: 0.7;
	}
	.other-dates {
		margin-top: auto;
	}
	.section-title-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.section-title-row h2 {
		margin: 0;
		font-size: var(--h3);
	}
	.section-title-row a {
		color: var(--text);
		border-bottom-color: var(--text);
		font-size: var(--small);
	}
	.other-dates-list {
		display: flex;
		gap: 0.6rem;
	}
	.other-dates-list a {
		display: grid;
		gap: 0.25rem;
		flex: 1;
		padding: 0.8rem;
		border: 1px solid color-mix(in srgb, var(--text) 15%, transparent);
		border-radius: 0.25rem;
		color: var(--text);
	}
	.other-dates-list a:hover {
		border-color: var(--secondary);
	}
	@media screen and (max-width: 700px) {
		.detail-banner {
			min-height: 240px;
		}
		.detail-heading {
			padding: 1.25rem;
		}
		.information-grid {
			grid-template-columns: 1fr;
			gap: 0.8rem;
		}
		.other-dates-list {
			overflow-x: auto;
			flex-direction: column;
		}
		.other-dates-list a {
			min-width: 150px;
		}
	}
</style>
