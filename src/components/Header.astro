---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import HeaderLink from '../components/HeaderLink.astro';
import JoinButton from '../components/JoinButton.astro';
import AdherentWidget from '../components/AdherentWidget.astro';
import { SITE_TITLE } from '../consts';
import { loadQuery } from "../lib/load-query";
import { getReservationSession } from '../lib/reservation-auth';

import logo from '../assets/rnr_logo.svg';

let enabled
const referrer = Astro.url.href
if (referrer.includes('preview')) {enabled = 'true'} else {enabled = 'false'}

const { data: header } = await loadQuery({
	query: `*[_type == "header"][0]{
	links[]{
		linkType,
		slug,
		title,
		page->{
			"slug": slug.current
		}
	}}`,
	params: {},
	enabled,
});

const memberEmail = await getReservationSession(Astro.cookies);
---

<header id="header">
	<div class="header-content" id="menu">
		<div class="title-container header-left" transition:persist>
			<a class="title-link" href="/">
				<Image class="header-img" src={logo} alt="Logo de Rokhs & Rôles" height={35} />
				<span class="title-label">{SITE_TITLE}</span>
			</a>
		</div>

		<div class="header-links" id="navbar">
			
			{header?.links?.map((link: any) => {
				const type = link.linkType
				const pageTitle = link.title
				const pageSlug = type === 'page'
					? (link.page.slug === '/' ? '/' : `/${link.page.slug}`)
					: `/${link.slug}`
				
				return <HeaderLink href={pageSlug}>{pageTitle}</HeaderLink>
			})}
			<div class="header-link-join">
				{memberEmail ? (
					<div class="adherent-widget">
						<Icon aria-hidden="true" name="lucide:user" />
						<span class="adherent-email">{memberEmail}</span>
					</div>
				) : (
					<JoinButton />
				)}
			</div>
			<a class="menu-icon" onclick="toggleMenu()">
				<Icon aria-hidden="true" name="lucide:menu"/>
			</a>
		</div>

		<div class="join-container header-right" transition:persist>
			{memberEmail ? (
				<AdherentWidget email={memberEmail} />
			) : (
				<JoinButton />
			)}
		</div>
	</div>
</header>

<script is:inline>
	function toggleMenu() {
		var e = document.getElementById("navbar");
		if (!e) return;

		if (e.className === "header-links") {
			e.className += " responsive";
		} else {
			e.className = "header-links";
		}
	}
</script>

<style>
	.adherent-widget {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.9rem;
		border: 1px solid color-mix(in srgb, var(--text) 20%, transparent);
		border-radius: var(--border05);
		background: color-mix(in srgb, var(--secondary) 10%, var(--background));
		font-size: var(--small);
		font-weight: 600;
		color: var(--text);
	}

	.adherent-widget :global(svg) {
		width: 1.1em;
		height: 1.1em;
		color: var(--secondary);
		flex-shrink: 0;
	}

	.adherent-email {
		max-width: 200px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>